# The game server (backend/) the app talks to. It is baked into the build, so the player never
# types an address: they only sign in and sync. Copy this file to .env before a published build.
#
# When this is unset, the dev preview reaches the backend on port 8000 through its own dev
# server (set KFM_BACKEND_URL to point that somewhere else).
VITE_API_URL=https://example.com/api
